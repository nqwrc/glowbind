# Only used by the optional local companion server (npm start), which bridges
# the static site to a real RGB keyboard via OpenRGB and to Gemini for search.
# The static site itself (npm run build / npm run preview) reads none of these.
#
# Preferred storage for the Gemini key is Windows Credential Manager
# (npm run set-key), not this file. GEMINI_API_KEY below is only a fallback
# read directly from the environment when nothing is in the Credential Manager
# (see server/src/secrets.ts).

PORT=3000
OPENRGB_HOST=127.0.0.1
OPENRGB_PORT=6742
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
