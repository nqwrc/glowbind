{
  "id": "chrome",
  "name": "Google Chrome",
  "keybinds": [
    { "id": "new-tab", "action": "Apre una nuova scheda", "keys": [["Ctrl", "T"]], "category": "schede", "keywords": ["tab", "nuova scheda"] },
    { "id": "close-tab", "action": "Chiude la scheda corrente", "keys": [["Ctrl", "W"]], "category": "schede" },
    { "id": "reopen-tab", "action": "Riapre l'ultima scheda chiusa", "keys": [["Ctrl", "Shift", "T"]], "category": "schede", "keywords": ["recupera scheda"] },
    { "id": "new-window", "action": "Apre una nuova finestra", "keys": [["Ctrl", "N"]], "category": "finestre" },
    { "id": "incognito", "action": "Apre una finestra di navigazione in incognito", "keys": [["Ctrl", "Shift", "N"]], "category": "finestre", "keywords": ["privata", "anonima"] },
    { "id": "next-tab", "action": "Passa alla scheda successiva", "keys": [["Ctrl", "Tab"]], "category": "schede" },
    { "id": "prev-tab", "action": "Passa alla scheda precedente", "keys": [["Ctrl", "Shift", "Tab"]], "category": "schede" },
    { "id": "first-tab", "action": "Va alla prima scheda", "keys": [["Ctrl", "1"]], "category": "schede" },
    { "id": "last-tab", "action": "Va all'ultima scheda", "keys": [["Ctrl", "9"]], "category": "schede" },
    { "id": "address-bar", "action": "Sposta il cursore nella barra degli indirizzi", "keys": [["Ctrl", "L"]], "category": "navigazione", "keywords": ["url", "barra indirizzi", "cerca"] },
    { "id": "bookmark", "action": "Aggiunge la pagina ai preferiti", "keys": [["Ctrl", "D"]], "category": "preferiti", "keywords": ["segnalibro", "salva pagina"] },
    { "id": "bookmark-manager", "action": "Apre la gestione dei preferiti", "keys": [["Ctrl", "Shift", "O"]], "category": "preferiti" },
    { "id": "history", "action": "Apre la cronologia", "keys": [["Ctrl", "H"]], "category": "navigazione" },
    { "id": "downloads", "action": "Apre i download", "keys": [["Ctrl", "J"]], "category": "navigazione", "keywords": ["scaricati"] },
    { "id": "find", "action": "Cerca nella pagina", "keys": [["Ctrl", "F"]], "category": "pagina", "keywords": ["trova"] },
    { "id": "print", "action": "Stampa la pagina", "keys": [["Ctrl", "P"]], "category": "pagina" },
    { "id": "save-page", "action": "Salva la pagina sul computer", "keys": [["Ctrl", "S"]], "category": "pagina" },
    { "id": "reload", "action": "Ricarica la pagina", "keys": [["Ctrl", "R"]], "category": "pagina", "keywords": ["aggiorna"] },
    { "id": "hard-reload", "action": "Ricarica la pagina ignorando la cache", "keys": [["Ctrl", "Shift", "R"]], "category": "pagina", "keywords": ["svuota cache"] },
    { "id": "back", "action": "Torna alla pagina precedente", "keys": [["Alt", "Left"]], "category": "navigazione", "keywords": ["indietro"] },
    { "id": "forward", "action": "Va alla pagina successiva", "keys": [["Alt", "Right"]], "category": "navigazione", "keywords": ["avanti"] },
    { "id": "home", "action": "Apre la pagina iniziale", "keys": [["Alt", "Home"]], "category": "navigazione" },
    { "id": "zoom-reset", "action": "Riporta lo zoom al 100%", "keys": [["Ctrl", "0"]], "category": "zoom" },
    { "id": "zoom-in", "action": "Aumenta lo zoom della pagina", "keys": [["Ctrl", "="]], "category": "zoom", "keywords": ["ingrandisci"] },
    { "id": "zoom-out", "action": "Riduce lo zoom della pagina", "keys": [["Ctrl", "-"]], "category": "zoom", "keywords": ["rimpicciolisci"] },
    { "id": "devtools", "action": "Apre gli strumenti per sviluppatori", "keys": [["F12"]], "category": "sviluppo", "keywords": ["devtools", "ispeziona"] },
    { "id": "inspect", "action": "Apre gli strumenti per sviluppatori sull'elemento", "keys": [["Ctrl", "Shift", "I"]], "category": "sviluppo" },
    { "id": "console", "action": "Apre la console JavaScript", "keys": [["Ctrl", "Shift", "J"]], "category": "sviluppo" },
    { "id": "clear-data", "action": "Apre la cancellazione dei dati di navigazione", "keys": [["Ctrl", "Shift", "Delete"]], "category": "privacy", "keywords": ["cancella cronologia", "svuota"] },
    { "id": "fullscreen", "action": "Attiva o disattiva lo schermo intero", "keys": [["F11"]], "category": "finestre" },
    { "id": "stop", "action": "Interrompe il caricamento della pagina", "keys": [["Esc"]], "category": "pagina" },
    { "id": "task-manager", "action": "Apre la gestione attivita' di Chrome", "keys": [["Shift", "Esc"]], "category": "sviluppo" }
  ]
}
