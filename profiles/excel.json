{
  "id": "excel",
  "name": "Microsoft Excel",
  "keybinds": [
    { "id": "edit-cell", "action": "Modifica la cella selezionata", "keys": [["F2"]], "category": "modifica", "keywords": ["entra nella cella"] },
    { "id": "autosum", "action": "Inserisce la somma automatica", "keys": [["Alt", "="]], "category": "formule", "keywords": ["somma", "totale"] },
    { "id": "absolute-ref", "action": "Rende assoluto il riferimento nella formula", "keys": [["F4"]], "category": "formule", "keywords": ["dollaro", "blocca riferimento"] },
    { "id": "format-cells", "action": "Apre la finestra Formato celle", "keys": [["Ctrl", "1"]], "category": "formattazione" },
    { "id": "bold", "action": "Applica o rimuove il grassetto", "keys": [["Ctrl", "B"]], "category": "formattazione" },
    { "id": "italic", "action": "Applica o rimuove il corsivo", "keys": [["Ctrl", "I"]], "category": "formattazione" },
    { "id": "underline", "action": "Applica o rimuove la sottolineatura", "keys": [["Ctrl", "U"]], "category": "formattazione" },
    { "id": "go-a1", "action": "Torna alla cella A1", "keys": [["Ctrl", "Home"]], "category": "navigazione" },
    { "id": "go-last", "action": "Va all'ultima cella usata del foglio", "keys": [["Ctrl", "End"]], "category": "navigazione" },
    { "id": "jump-edge", "action": "Salta al bordo dei dati verso il basso", "keys": [["Ctrl", "Down"]], "category": "navigazione", "keywords": ["fine colonna"] },
    { "id": "select-to-edge", "action": "Seleziona fino al bordo dei dati verso il basso", "keys": [["Ctrl", "Shift", "Down"]], "category": "selezione" },
    { "id": "select-column", "action": "Seleziona l'intera colonna", "keys": [["Ctrl", "Space"]], "category": "selezione" },
    { "id": "select-row", "action": "Seleziona l'intera riga", "keys": [["Shift", "Space"]], "category": "selezione" },
    { "id": "insert-cells", "action": "Inserisce celle, righe o colonne", "keys": [["Ctrl", "Shift", "="]], "category": "modifica" },
    { "id": "delete-cells", "action": "Elimina celle, righe o colonne", "keys": [["Ctrl", "-"]], "category": "modifica" },
    { "id": "fill-down", "action": "Copia la cella superiore verso il basso", "keys": [["Ctrl", "D"]], "category": "modifica", "keywords": ["riempi in basso"] },
    { "id": "fill-right", "action": "Copia la cella a sinistra verso destra", "keys": [["Ctrl", "R"]], "category": "modifica", "keywords": ["riempi a destra"] },
    { "id": "insert-date", "action": "Inserisce la data di oggi", "keys": [["Ctrl", ";"]], "category": "inserimento" },
    { "id": "hyperlink", "action": "Inserisce un collegamento ipertestuale", "keys": [["Ctrl", "K"]], "category": "inserimento", "keywords": ["link"] },
    { "id": "create-table", "action": "Crea una tabella dai dati selezionati", "keys": [["Ctrl", "T"]], "category": "dati" },
    { "id": "filter", "action": "Attiva o disattiva i filtri", "keys": [["Ctrl", "Shift", "L"]], "category": "dati", "keywords": ["filtro"] },
    { "id": "find", "action": "Cerca nel foglio", "keys": [["Ctrl", "F"]], "category": "ricerca" },
    { "id": "replace", "action": "Cerca e sostituisce nel foglio", "keys": [["Ctrl", "H"]], "category": "ricerca" },
    { "id": "goto", "action": "Apre Vai a per raggiungere una cella", "keys": [["Ctrl", "G"]], "category": "navigazione" },
    { "id": "next-sheet", "action": "Passa al foglio successivo", "keys": [["Ctrl", "PageDown"]], "category": "fogli" },
    { "id": "prev-sheet", "action": "Passa al foglio precedente", "keys": [["Ctrl", "PageUp"]], "category": "fogli" },
    { "id": "new-workbook", "action": "Crea una nuova cartella di lavoro", "keys": [["Ctrl", "N"]], "category": "file" },
    { "id": "save", "action": "Salva la cartella di lavoro", "keys": [["Ctrl", "S"]], "category": "file" },
    { "id": "print", "action": "Apre la stampa", "keys": [["Ctrl", "P"]], "category": "file" },
    { "id": "recalculate", "action": "Ricalcola tutte le formule", "keys": [["F9"]], "category": "formule" },
    { "id": "hide-rows", "action": "Nasconde le righe selezionate", "keys": [["Ctrl", "9"]], "category": "formattazione" },
    { "id": "hide-columns", "action": "Nasconde le colonne selezionate", "keys": [["Ctrl", "0"]], "category": "formattazione" },
    { "id": "new-line-in-cell", "action": "Va a capo dentro la stessa cella", "keys": [["Alt", "Enter"]], "category": "modifica", "keywords": ["a capo", "ritorno"] },
    { "id": "fill-selection", "action": "Conferma inserendo il valore in tutte le celle selezionate", "keys": [["Ctrl", "Enter"]], "category": "modifica" }
  ]
}
