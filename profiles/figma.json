{
  "id": "figma",
  "name": "Figma",
  "keybinds": [
    { "id": "move", "action": "Seleziona lo strumento Sposta", "keys": [["V"]], "category": "strumenti", "keywords": ["move", "freccia"] },
    { "id": "frame", "action": "Seleziona lo strumento Frame", "keys": [["F"]], "category": "strumenti", "keywords": ["artboard", "tavola"] },
    { "id": "rectangle", "action": "Seleziona lo strumento Rettangolo", "keys": [["R"]], "category": "strumenti", "keywords": ["quadrato", "forma"] },
    { "id": "ellipse", "action": "Seleziona lo strumento Ellisse", "keys": [["O"]], "category": "strumenti", "keywords": ["cerchio"] },
    { "id": "line", "action": "Seleziona lo strumento Linea", "keys": [["L"]], "category": "strumenti" },
    { "id": "text", "action": "Seleziona lo strumento Testo", "keys": [["T"]], "category": "strumenti" },
    { "id": "pen", "action": "Seleziona lo strumento Penna", "keys": [["P"]], "category": "strumenti", "keywords": ["vettoriale", "tracciato"] },
    { "id": "scale", "action": "Seleziona lo strumento Scala", "keys": [["K"]], "category": "strumenti", "keywords": ["ridimensiona"] },
    { "id": "comment", "action": "Seleziona lo strumento Commento", "keys": [["C"]], "category": "strumenti" },
    { "id": "slice", "action": "Seleziona lo strumento Slice", "keys": [["S"]], "category": "strumenti", "keywords": ["ritaglio esportazione"] },
    { "id": "group", "action": "Raggruppa gli elementi selezionati", "keys": [["Ctrl", "G"]], "category": "organizzazione", "keywords": ["gruppo"] },
    { "id": "ungroup", "action": "Separa il gruppo selezionato", "keys": [["Ctrl", "Shift", "G"]], "category": "organizzazione" },
    { "id": "frame-selection", "action": "Racchiude la selezione in un frame", "keys": [["Ctrl", "Alt", "G"]], "category": "organizzazione" },
    { "id": "duplicate", "action": "Duplica la selezione", "keys": [["Ctrl", "D"]], "category": "modifica" },
    { "id": "create-component", "action": "Crea un componente dalla selezione", "keys": [["Ctrl", "Alt", "K"]], "category": "componenti" },
    { "id": "detach-instance", "action": "Stacca l'istanza dal componente", "keys": [["Ctrl", "Alt", "B"]], "category": "componenti" },
    { "id": "auto-layout", "action": "Applica l'auto layout alla selezione", "keys": [["Shift", "A"]], "category": "layout" },
    { "id": "remove-auto-layout", "action": "Rimuove l'auto layout", "keys": [["Alt", "Shift", "A"]], "category": "layout" },
    { "id": "flatten", "action": "Unisce la selezione in un unico vettore", "keys": [["Ctrl", "E"]], "category": "vettori", "keywords": ["flatten", "appiattisci"] },
    { "id": "outline-stroke", "action": "Converte il bordo in tracciato", "keys": [["Ctrl", "Shift", "O"]], "category": "vettori" },
    { "id": "copy-properties", "action": "Copia le proprieta' dell'elemento", "keys": [["Ctrl", "Alt", "C"]], "category": "modifica" },
    { "id": "paste-properties", "action": "Incolla le proprieta' sull'elemento", "keys": [["Ctrl", "Alt", "V"]], "category": "modifica" },
    { "id": "paste-over", "action": "Incolla sopra la selezione", "keys": [["Ctrl", "Shift", "V"]], "category": "modifica" },
    { "id": "export", "action": "Apre il pannello di esportazione", "keys": [["Ctrl", "Shift", "E"]], "category": "esportazione" },
    { "id": "place-image", "action": "Inserisce un'immagine", "keys": [["Ctrl", "Shift", "K"]], "category": "modifica" },
    { "id": "quick-actions", "action": "Apre la ricerca rapida delle azioni", "keys": [["Ctrl", "/"]], "category": "generale", "keywords": ["comandi", "palette"] },
    { "id": "zoom-fit", "action": "Adatta lo zoom a tutto il contenuto", "keys": [["Shift", "1"]], "category": "vista" },
    { "id": "zoom-selection", "action": "Zooma sulla selezione", "keys": [["Shift", "2"]], "category": "vista" },
    { "id": "zoom-100", "action": "Porta lo zoom al 100%", "keys": [["Shift", "0"]], "category": "vista" },
    { "id": "toggle-ui", "action": "Mostra o nasconde tutti i pannelli", "keys": [["Ctrl", "\\"]], "category": "vista", "keywords": ["interfaccia", "pulisci schermo"] },
    { "id": "rulers", "action": "Mostra o nasconde i righelli", "keys": [["Shift", "R"]], "category": "vista" },
    { "id": "toggle-multiplayer", "action": "Mostra o nasconde i cursori dei collaboratori", "keys": [["Ctrl", "Alt", "\\"]], "category": "vista" },
    { "id": "select-all", "action": "Seleziona tutti gli elementi", "keys": [["Ctrl", "A"]], "category": "selezione" },
    { "id": "bring-front", "action": "Porta la selezione in primo piano", "keys": [["Ctrl", "Shift", "]"]], "category": "organizzazione" },
    { "id": "send-back", "action": "Porta la selezione in fondo", "keys": [["Ctrl", "Shift", "["]], "category": "organizzazione" }
  ]
}
