{
  "id": "intellij",
  "name": "IntelliJ IDEA",
  "keybinds": [
    { "id": "find-action", "action": "Cerca ed esegue qualsiasi azione dell'IDE", "keys": [["Ctrl", "Shift", "A"]], "category": "generale", "keywords": ["comandi", "palette"] },
    { "id": "goto-class", "action": "Apre una classe per nome", "keys": [["Ctrl", "N"]], "category": "navigazione" },
    { "id": "goto-file", "action": "Apre un file per nome", "keys": [["Ctrl", "Shift", "N"]], "category": "navigazione" },
    { "id": "recent-files", "action": "Mostra i file aperti di recente", "keys": [["Ctrl", "E"]], "category": "navigazione" },
    { "id": "goto-declaration", "action": "Va alla dichiarazione del simbolo", "keys": [["Ctrl", "B"]], "category": "navigazione", "keywords": ["definizione"] },
    { "id": "goto-implementation", "action": "Va all'implementazione del simbolo", "keys": [["Ctrl", "Alt", "B"]], "category": "navigazione" },
    { "id": "file-structure", "action": "Mostra la struttura del file", "keys": [["Ctrl", "F12"]], "category": "navigazione", "keywords": ["metodi", "outline"] },
    { "id": "goto-line", "action": "Va a una riga specifica", "keys": [["Ctrl", "G"]], "category": "navigazione" },
    { "id": "intention", "action": "Mostra le correzioni rapide e le intenzioni", "keys": [["Alt", "Enter"]], "category": "editing", "keywords": ["quick fix", "lampadina"] },
    { "id": "reformat", "action": "Riformatta il codice", "keys": [["Ctrl", "Alt", "L"]], "category": "editing", "keywords": ["formatta", "indenta"] },
    { "id": "optimize-imports", "action": "Ottimizza gli import", "keys": [["Ctrl", "Alt", "O"]], "category": "editing" },
    { "id": "comment-line", "action": "Commenta o decommenta la riga", "keys": [["Ctrl", "/"]], "category": "editing" },
    { "id": "block-comment", "action": "Commenta o decommenta un blocco", "keys": [["Ctrl", "Shift", "/"]], "category": "editing" },
    { "id": "duplicate-line", "action": "Duplica la riga o la selezione", "keys": [["Ctrl", "D"]], "category": "editing" },
    { "id": "delete-line", "action": "Elimina la riga corrente", "keys": [["Ctrl", "Y"]], "category": "editing" },
    { "id": "complete-statement", "action": "Completa l'istruzione corrente", "keys": [["Ctrl", "Shift", "Enter"]], "category": "editing" },
    { "id": "parameter-info", "action": "Mostra i parametri del metodo", "keys": [["Ctrl", "P"]], "category": "editing" },
    { "id": "quick-doc", "action": "Mostra la documentazione rapida", "keys": [["Ctrl", "Q"]], "category": "editing" },
    { "id": "extend-selection", "action": "Estende la selezione al blocco superiore", "keys": [["Ctrl", "W"]], "category": "selezione" },
    { "id": "shrink-selection", "action": "Riduce la selezione", "keys": [["Ctrl", "Shift", "W"]], "category": "selezione" },
    { "id": "rename", "action": "Rinomina il simbolo ovunque", "keys": [["Shift", "F6"]], "category": "refactoring" },
    { "id": "extract-variable", "action": "Estrae una variabile", "keys": [["Ctrl", "Alt", "V"]], "category": "refactoring" },
    { "id": "extract-method", "action": "Estrae un metodo", "keys": [["Ctrl", "Alt", "M"]], "category": "refactoring" },
    { "id": "generate", "action": "Genera costruttori, getter e setter", "keys": [["Alt", "Insert"]], "category": "generazione" },
    { "id": "override", "action": "Sovrascrive i metodi della classe padre", "keys": [["Ctrl", "O"]], "category": "generazione" },
    { "id": "implement", "action": "Implementa i metodi dell'interfaccia", "keys": [["Ctrl", "I"]], "category": "generazione" },
    { "id": "find-usages", "action": "Trova tutti gli utilizzi del simbolo", "keys": [["Alt", "F7"]], "category": "ricerca" },
    { "id": "find-in-files", "action": "Cerca in tutto il progetto", "keys": [["Ctrl", "Shift", "F"]], "category": "ricerca" },
    { "id": "replace-in-files", "action": "Sostituisce in tutto il progetto", "keys": [["Ctrl", "Shift", "R"]], "category": "ricerca" },
    { "id": "run", "action": "Esegue la configurazione corrente", "keys": [["Shift", "F10"]], "category": "esecuzione" },
    { "id": "debug", "action": "Avvia il debug", "keys": [["Shift", "F9"]], "category": "esecuzione" },
    { "id": "toggle-breakpoint", "action": "Attiva o disattiva un breakpoint", "keys": [["Ctrl", "F8"]], "category": "debug" },
    { "id": "step-over", "action": "Esegue la riga corrente nel debug", "keys": [["F8"]], "category": "debug" },
    { "id": "step-into", "action": "Entra nel metodo durante il debug", "keys": [["F7"]], "category": "debug" },
    { "id": "resume", "action": "Riprende l'esecuzione nel debug", "keys": [["F9"]], "category": "debug" },
    { "id": "terminal", "action": "Apre il terminale integrato", "keys": [["Alt", "F12"]], "category": "strumenti" }
  ]
}
