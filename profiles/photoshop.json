    { "id": "duplicate-layer", "action": "Duplica il livello selezionato", "keys": [["Ctrl", "J"]], "category": "livelli" },
    { "id": "new-layer", "action": "Crea un nuovo livello", "keys": [["Ctrl", "Shift", "N"]], "category": "livelli" },
    { "id": "group-layers", "action": "Raggruppa i livelli selezionati", "keys": [["Ctrl", "G"]], "category": "livelli" },
    { "id": "merge-down", "action": "Unisce il livello con quello sottostante", "keys": [["Ctrl", "E"]], "category": "livelli" },
    { "id": "merge-visible", "action": "Unisce tutti i livelli visibili", "keys": [["Ctrl", "Shift", "E"]], "category": "livelli" },
    { "id": "free-transform", "action": "Attiva la trasformazione libera", "keys": [["Ctrl", "T"]], "category": "trasformazione", "keywords": ["ridimensiona", "ruota"] },
    { "id": "deselect", "action": "Deseleziona tutto", "keys": [["Ctrl", "D"]], "category": "selezione" },
    { "id": "reselect", "action": "Ripristina l'ultima selezione", "keys": [["Ctrl", "Shift", "D"]], "category": "selezione" },
    { "id": "inverse", "action": "Inverte la selezione", "keys": [["Ctrl", "Shift", "I"]], "category": "selezione" },
    { "id": "select-all", "action": "Seleziona tutta la tela", "keys": [["Ctrl", "A"]], "category": "selezione" },
    { "id": "levels", "action": "Apre la regolazione Livelli", "keys": [["Ctrl", "L"]], "category": "regolazioni" },
    { "id": "curves", "action": "Apre la regolazione Curve", "keys": [["Ctrl", "M"]], "category": "regolazioni" },
    { "id": "hue-saturation", "action": "Apre Tonalita' e saturazione", "keys": [["Ctrl", "U"]], "category": "regolazioni" },
    { "id": "desaturate", "action": "Desatura l'immagine", "keys": [["Ctrl", "Shift", "U"]], "category": "regolazioni", "keywords": ["bianco e nero"] },
    { "id": "image-size", "action": "Apre Dimensione immagine", "keys": [["Ctrl", "Alt", "I"]], "category": "documento" },
    { "id": "canvas-size", "action": "Apre Dimensione quadro", "keys": [["Ctrl", "Alt", "C"]], "category": "documento" },
    { "id": "fit-screen", "action": "Adatta l'immagine allo schermo", "keys": [["Ctrl", "0"]], "category": "vista" },
    { "id": "zoom-100", "action": "Porta lo zoom al 100%", "keys": [["Ctrl", "1"]], "category": "vista" },
    { "id": "hide-panels", "action": "Mostra o nasconde tutti i pannelli", "keys": [["Tab"]], "category": "vista" },
    { "id": "step-backward", "action": "Torna indietro di un passo nella cronologia", "keys": [["Ctrl", "Alt", "Z"]], "category": "cronologia", "keywords": ["annulla piu' volte"] },
    { "id": "save-as", "action": "Salva con nome", "keys": [["Ctrl", "Shift", "S"]], "category": "file" }
  ]
}
