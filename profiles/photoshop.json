{
  "id": "photoshop",
  "name": "Adobe Photoshop",
  "keybinds": [
    { "id": "move", "action": "Seleziona lo strumento Sposta", "keys": [["V"]], "category": "strumenti" },
    { "id": "marquee", "action": "Seleziona lo strumento Selezione rettangolare", "keys": [["M"]], "category": "strumenti" },
    { "id": "lasso", "action": "Seleziona lo strumento Lazo", "keys": [["L"]], "category": "strumenti" },
    { "id": "quick-selection", "action": "Seleziona lo strumento Selezione rapida", "keys": [["W"]], "category": "strumenti", "keywords": ["bacchetta magica"] },
    { "id": "crop", "action": "Seleziona lo strumento Taglierina", "keys": [["C"]], "category": "strumenti", "keywords": ["ritaglia"] },
    { "id": "eyedropper", "action": "Seleziona lo strumento Contagocce", "keys": [["I"]], "category": "strumenti", "keywords": ["preleva colore"] },
    { "id": "healing", "action": "Seleziona il Pennello correttivo al volo", "keys": [["J"]], "category": "strumenti", "keywords": ["correttivo", "ritocco"] },
    { "id": "brush", "action": "Seleziona lo strumento Pennello", "keys": [["B"]], "category": "strumenti" },
    { "id": "clone", "action": "Seleziona lo strumento Timbro clone", "keys": [["S"]], "category": "strumenti" },
    { "id": "eraser", "action": "Seleziona lo strumento Gomma", "keys": [["E"]], "category": "strumenti" },
    { "id": "gradient", "action": "Seleziona lo strumento Sfumatura", "keys": [["G"]], "category": "strumenti" },
    { "id": "type", "action": "Seleziona lo strumento Testo", "keys": [["T"]], "category": "strumenti" },
    { "id": "pen", "action": "Seleziona lo strumento Penna", "keys": [["P"]], "category": "strumenti", "keywords": ["tracciato"] },
    { "id": "hand", "action": "Seleziona lo strumento Mano", "keys": [["H"]], "category": "strumenti", "keywords": ["sposta vista"] },
    { "id": "zoom-tool", "action": "Seleziona lo strumento Zoom", "keys": [["Z"]], "category": "strumenti" },
