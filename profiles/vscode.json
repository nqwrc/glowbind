{
  "id": "vscode",
  "name": "VS Code",
  "keybinds": [
    { "id": "command-palette", "action": "Apre la Command Palette per eseguire qualsiasi comando", "keys": [["Ctrl", "Shift", "P"]], "category": "generale", "keywords": ["palette", "comandi"] },
    { "id": "quick-open", "action": "Apre rapidamente un file per nome", "keys": [["Ctrl", "P"]], "category": "navigazione", "keywords": ["cerca file", "vai al file"] },
    { "id": "toggle-terminal", "action": "Mostra o nasconde il terminale integrato", "keys": [["Ctrl", "`"]], "category": "terminale", "keywords": ["console", "shell"] },
    { "id": "new-terminal", "action": "Crea un nuovo terminale integrato", "keys": [["Ctrl", "Shift", "`"]], "category": "terminale" },
    { "id": "split-editor", "action": "Divide l'editor in due riquadri affiancati", "keys": [["Ctrl", "\\"]], "category": "editor", "keywords": ["split", "affianca"] },
    { "id": "toggle-sidebar", "action": "Mostra o nasconde la barra laterale", "keys": [["Ctrl", "B"]], "category": "layout", "keywords": ["sidebar", "esplora file"] },
    { "id": "keyboard-shortcuts", "action": "Apre l'elenco delle scorciatoie da tastiera", "keys": [["Ctrl", "K"], ["Ctrl", "S"]], "category": "impostazioni" },
    { "id": "settings", "action": "Apre le impostazioni", "keys": [["Ctrl", ","]], "category": "impostazioni" },
    { "id": "save", "action": "Salva il file corrente", "keys": [["Ctrl", "S"]], "category": "file" },
    { "id": "save-all", "action": "Salva tutti i file aperti", "keys": [["Ctrl", "K"], ["S"]], "category": "file" },
    { "id": "close-editor", "action": "Chiude l'editor corrente", "keys": [["Ctrl", "W"]], "category": "file", "keywords": ["chiudi scheda", "chiudi tab"] },
    { "id": "reopen-closed", "action": "Riapre l'ultimo editor chiuso", "keys": [["Ctrl", "Shift", "T"]], "category": "file" },
    { "id": "new-file", "action": "Crea un nuovo file", "keys": [["Ctrl", "N"]], "category": "file" },
    { "id": "find", "action": "Cerca nel file corrente", "keys": [["Ctrl", "F"]], "category": "ricerca", "keywords": ["trova"] },
    { "id": "replace", "action": "Cerca e sostituisce nel file corrente", "keys": [["Ctrl", "H"]], "category": "ricerca", "keywords": ["sostituisci"] },
    { "id": "find-in-files", "action": "Cerca in tutti i file del progetto", "keys": [["Ctrl", "Shift", "F"]], "category": "ricerca", "keywords": ["ricerca globale"] },
    { "id": "go-to-line", "action": "Va a una riga specifica", "keys": [["Ctrl", "G"]], "category": "navigazione", "keywords": ["riga", "salta"] },
    { "id": "go-to-symbol", "action": "Va a un simbolo nel file (funzione, classe)", "keys": [["Ctrl", "Shift", "O"]], "category": "navigazione" },
    { "id": "go-to-definition", "action": "Va alla definizione del simbolo sotto il cursore", "keys": [["F12"]], "category": "navigazione", "keywords": ["definizione"] },
    { "id": "peek-definition", "action": "Mostra la definizione in un riquadro senza cambiare file", "keys": [["Alt", "F12"]], "category": "navigazione" },
    { "id": "rename-symbol", "action": "Rinomina il simbolo sotto il cursore in tutto il progetto", "keys": [["F2"]], "category": "refactoring", "keywords": ["rinomina", "refactor"] },
    { "id": "format-document", "action": "Formatta l'intero documento", "keys": [["Shift", "Alt", "F"]], "category": "editing", "keywords": ["indenta", "formattazione"] },
    { "id": "quick-fix", "action": "Mostra le correzioni rapide e le azioni sul codice", "keys": [["Ctrl", "."]], "category": "editing", "keywords": ["quick fix", "suggerimenti"] },
    { "id": "toggle-comment", "action": "Commenta o decommenta la riga corrente", "keys": [["Ctrl", "/"]], "category": "editing", "keywords": ["commento"] },
    { "id": "block-comment", "action": "Commenta o decommenta un blocco", "keys": [["Shift", "Alt", "A"]], "category": "editing" },
    { "id": "copy-line-down", "action": "Duplica la riga corrente verso il basso", "keys": [["Shift", "Alt", "Down"]], "category": "editing", "keywords": ["duplica riga"] },
    { "id": "move-line-up", "action": "Sposta la riga corrente in alto", "keys": [["Alt", "Up"]], "category": "editing" },
    { "id": "move-line-down", "action": "Sposta la riga corrente in basso", "keys": [["Alt", "Down"]], "category": "editing" },
    { "id": "delete-line", "action": "Elimina la riga corrente", "keys": [["Ctrl", "Shift", "K"]], "category": "editing", "keywords": ["cancella riga"] },
    { "id": "select-line", "action": "Seleziona la riga corrente", "keys": [["Ctrl", "L"]], "category": "selezione" },
    { "id": "select-next-occurrence", "action": "Aggiunge la prossima occorrenza della selezione (multi cursore)", "keys": [["Ctrl", "D"]], "category": "selezione", "keywords": ["multi cursore", "occorrenza"] },
    { "id": "select-all-occurrences", "action": "Seleziona tutte le occorrenze della selezione corrente", "keys": [["Ctrl", "Shift", "L"]], "category": "selezione" },
    { "id": "add-cursor-below", "action": "Aggiunge un cursore sulla riga sotto", "keys": [["Ctrl", "Alt", "Down"]], "category": "selezione", "keywords": ["multi cursore"] },
    { "id": "expand-selection", "action": "Espande la selezione al blocco sintattico superiore", "keys": [["Shift", "Alt", "Right"]], "category": "selezione" },
    { "id": "zen-mode", "action": "Attiva la modalita' zen a schermo intero senza distrazioni", "keys": [["Ctrl", "K"], ["Z"]], "category": "layout", "keywords": ["zen", "concentrazione"] },
    { "id": "markdown-preview", "action": "Apre l'anteprima Markdown affiancata", "keys": [["Ctrl", "K"], ["V"]], "category": "layout" },
    { "id": "source-control", "action": "Apre il pannello del controllo versione (Git)", "keys": [["Ctrl", "Shift", "G"]], "category": "git", "keywords": ["git", "commit"] },
    { "id": "debug-start", "action": "Avvia il debug", "keys": [["F5"]], "category": "debug" },
    { "id": "debug-breakpoint", "action": "Attiva o disattiva un breakpoint sulla riga corrente", "keys": [["F9"]], "category": "debug", "keywords": ["breakpoint"] },
    { "id": "debug-step-over", "action": "Esegue la riga corrente nel debug (step over)", "keys": [["F10"]], "category": "debug" },
    { "id": "next-editor", "action": "Passa alla scheda successiva", "keys": [["Ctrl", "PageDown"]], "category": "navigazione", "keywords": ["scheda", "tab"] },
    { "id": "toggle-wrap", "action": "Attiva o disattiva il ritorno a capo automatico", "keys": [["Alt", "Z"]], "category": "editor", "keywords": ["word wrap"] }
  ]
}
